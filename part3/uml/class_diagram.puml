@startuml class_diagram
skinparam classAttributeIconSize 0

' ===== Captions =====
' <|-- : inheritance (is-a)
' ..>  : dependency (uses)
' -->  : association
' *--  : composition (owns)

' + : public
' # : protected

' ===== Agents =====
abstract class Agent {
  +get_action(state, deterministic: bool = false)
  +learn(...)
  +save(path)
  +load(path)
}

class QLearningAgent
abstract class BaseDQNAgent
class DQNAgent
class DoubleDQNAgent
class PPOAgent

Agent <|-- QLearningAgent
Agent <|-- BaseDQNAgent
Agent <|-- PPOAgent

BaseDQNAgent <|-- DQNAgent
BaseDQNAgent <|-- DoubleDQNAgent

' ===== Agent Configuration =====
class AgentSpec {
  +name : str
  +env_id : str
  +model_filename : str
  +build : Callable
}

AgentSpec ..> Agent : creates

' ===== Environment =====
abstract class DungeonCrawlerEnv {
  +reset()
  +step(action)
  +render()
  #_get_obs() : Observation
  #_define_observation_space()
}

class CNNDungeonEnv
class DQNDungeonEnv
class PPODungeonEnv

DungeonCrawlerEnv <|-- CNNDungeonEnv
DungeonCrawlerEnv <|-- DQNDungeonEnv
DungeonCrawlerEnv <|-- PPODungeonEnv

' Core encapsulated game state/logic
class DungeonGame
DungeonCrawlerEnv *-- DungeonGame : owns

DungeonCrawlerEnv --> Agent : interacts

' ===== Game Objects =====
abstract class GameObject {
  +row : int
  +col : int
  +can_pass(player) : bool
  +on_enter(player)
}

class Character
class Player
class Enemy

GameObject <|-- Character
Character <|-- Player
Character <|-- Enemy

abstract class Item

class Key
class Treasure
class Trap
class Door
class Wall

GameObject <|-- Item
Item <|-- Key
Item <|-- Treasure
Item <|-- Trap
GameObject <|-- Door
GameObject <|-- Wall

Player --> GameObject : steps on / interacts
Player --> Item : picks up / triggers

@enduml
